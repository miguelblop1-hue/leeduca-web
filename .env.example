# AI generation for themed exercise sets (optional)
# Configure one provider to enable "Generate with AI" in the practice area.

# Groq (OpenAI-compatible)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Generic override for exercise generation model (used if provider-specific model is not set)
# EXERCISES_AI_MODEL=
